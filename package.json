{
  "name": "onboardx-status-page",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone status page for the OnboardX Discord bot. Reads directly from MongoDB - no external API.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "status",
    "statuspage",
    "onboardx",
    "nextjs"
  ],
  "author": "OnboardX Team",
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.3.1",
    "mongodb": "^7.5.0",
    "next": "^14.2.3",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "typescript": "^5.2.0"
  }
}