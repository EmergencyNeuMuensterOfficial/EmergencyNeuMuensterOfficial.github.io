# MongoDB connection used by the bot (or copy it from the bot's environment).
MONGODB_URI=mongodb://127.0.0.1:27017
# IMPORTANT: this must match the actual database name the bot writes to
# (case-sensitive). The bot uses "OnboardX".
MONGODB_DATABASE=OnboardX
# Optional: if MONGODB_DATABASE is not set, DB_NAME is used as a fallback.
DB_NAME=OnboardX

# --- Discord OAuth for /dashboard -----------------------------------------
# Create an application at https://discord.com/developers/applications
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_SECRET=your_discord_client_secret
# JWT secret used to sign session cookies (generate a long random string).
JWT_SECRET=change-me
# Bot token used to verify which servers OnboardX is present in.
# Omit it and the dashboard shows all admin servers instead.
DISCORD_TOKEN=your_bot_token

# Optional MongoDB driver options
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_TLS=false
MONGODB_DIRECT_CONNECTION=false